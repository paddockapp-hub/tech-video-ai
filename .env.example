# OpenAI API Configuration (클라우드 모드 시 필요)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Google AI Configuration (클라우드 모드 시 필요)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-pro
GOOGLE_IMAGE_MODEL=gemini-nano-banana-2.1

# Local AI Configuration (로컬 모드 시 사용)
USE_LOCAL_AI=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
AUTH_TOKEN=
SD_HOST=http://127.0.0.1:7860

# Text-to-speech (gTTS works without credentials; ElevenLabs requires both key and voice)
TTS_PROVIDER=gtts
TTS_API_KEY=
TTS_VOICE=
TTS_LANGUAGE=ko-KR

# Video Generation Configuration
VIDEO_DURATION=30
FPS=30
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1920

# Output Configuration
OUTPUT_DIR=output
TEMP_DIR=temp

# Firebase Configuration
FIREBASE_ENABLED=false
FIREBASE_KEY_PATH=firebase-adminsdk-key.json
FIREBASE_STORAGE_BUCKET=

# GitHub OAuth Configuration
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Storage Configuration
STORAGE_TYPE=local  # local, firebase, s3
LOCAL_STORAGE_DIR=uploads
S3_BUCKET_NAME=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
